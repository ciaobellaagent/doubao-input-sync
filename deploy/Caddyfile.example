# Caddy terminates HTTPS. Authentication must cover every route, including APIs.
# Start the loopback relay with --public-origin https://sync.example.com
# Set a real hostname and a password hash generated by `caddy hash-password`.
# This browser example needs gateway-compatible auth for unattended receivers;
# see SECURITY.md before deploying. Never publish a relay with an auth bypass.
sync.example.com {
    basic_auth {
        user {$DOUBAO_PASSWORD_HASH}
    }
    reverse_proxy 127.0.0.1:18766
}
